      <circle cx="333" cy="86" r="5" fill="var(--sl-color-bg)" />
      <circle cx="381" cy="86" r="5" fill="var(--sl-color-bg)" />
      <path d="M337 84 L376 84" />
      <path d="M77 139 H153 M91 177 H139" />
      <path d="M115 184 V177 M115 139 V138"/>
      <path d="M585 135 L573 145 L597 157 L573 169 L597 181 L585 199"/>
    </g>
    <g fill="var(--sl-color-accent)" stroke="var(--sl-color-accent)" stroke-width="3" stroke-linecap="round">
      <path d="M420 70 L437 86 L420 102" fill="none" />
      <path d="M569 211 L585 227 L601 211" fill="none" />
    </g>
    <g font-size="21" fill="currentColor">
      <text x="55" y="136">+</text>
      <text x="55" y="185">−</text>
      <text x="168" y="163">U = 12 В</text>
      <text x="520" y="165" text-anchor="end">R = 24 Ом</text>
