---
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props { expression: string; label: string; detail?: string }
const { expression, label, detail } = Astro.props;
// Static HTML + MathML; no client-side rendering or layout shift.
const renderedExpression = katex.renderToString(expression, {
  displayMode: true,
  output: 'htmlAndMathml',
  throwOnError: true,
});
---
<div class="not-content formula" role="group" aria-label={label}>
  <div class="eyebrow">{label}</div>
  <div class="expression" set:html={renderedExpression}></div>
  {detail && <div class="detail">{detail}</div>}
</div>
<style>
.formula{background:var(--sl-color-bg-sidebar);border:1px solid var(--sl-color-hairline);border-radius:14px;padding:1rem 1.2rem;margin:1rem 0}
.eyebrow{font-size:.76rem;font-weight:750;color:var(--sl-color-accent-high);letter-spacing:.03em;text-transform:uppercase}
.expression{font-size:clamp(1.2rem,2.6vw,1.7rem);font-weight:400;line-height:1.4;color:var(--sl-color-text);margin:.65rem 0;max-width:100%}
.expression :global(.katex-display){margin:0;overflow-x:auto;overflow-y:hidden;padding:.25rem 0;scrollbar-width:thin;text-align:left}
.expression :global(.katex-display>.katex){text-align:left;white-space:nowrap}
.detail{font-size:.86rem;color:var(--sl-color-text);line-height:1.65}
@media(max-width:30rem){.formula{padding:.85rem 1rem}.expression{font-size:1.25rem}}
</style>
